# Trivia Night — React Native environment config
# Copy this to .env and fill in your values

# WebSocket URL pointing at your trivia-night server
#
# Local dev options:
#   iOS simulator only:          ws://localhost:3000
#   Android emulator only:       ws://10.0.2.2:3000
#   Both iOS + Android sims:     ws://192.168.x.x:3000  (Mac LAN IP)
#
# Production (alphinium user-pod):
#   wss://<deploy-id>.user-pods.alphinium.io
#
# Note: Android emulator cannot reach ws://localhost — it routes to the
# emulator's own loopback, not the host machine. Use 10.0.2.2 or LAN IP.
EXPO_PUBLIC_WS_URL=ws://192.168.x.x:3000

# App display name (optional)
EXPO_PUBLIC_APP_NAME=Trivia Night

# alphinium-ai / Quiz Master AI commentary (optional)
#
# The AI commentary endpoint is AUTO-DERIVED from EXPO_PUBLIC_WS_URL (appends /ai-agent).
# On web it also auto-detects from the page origin.
# Only set this if you need to override the auto-detected URL.
#
# Example:  EXPO_PUBLIC_ALPHINIUM_AI_URL=wss://trivia.example.com/ai-agent
#
# Server-side AI config (set in the trivia-night server's environment):
#   OLLAMA_URL=http://<ollama-host>:11434   (required for live AI — no default)
#   OLLAMA_MODEL=dolphin-mistral:latest     (optional — default shown)
#   OLLAMA_TIMEOUT_MS=8000                  (optional — default shown)
EXPO_PUBLIC_ALPHINIUM_AI_URL=
